# VinVenture Lambda Environment Variables
# Copy this file to .env and update with your actual values

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012

# Cognito Configuration
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX
COGNITO_USER_POOL_ARN=arn:aws:cognito-idp:us-east-1:123456789012:userpool/us-east-1_XXXXXXXXX

# Database Configuration
DB_CLUSTER_ARN=arn:aws:rds:us-east-1:123456789012:cluster:vinventure-db
DB_SECRET_ARN=arn:aws:secretsmanager:us-east-1:123456789012:secret:vinventure-db-secret
DATABASE_URL=postgresql://username:password@hostname:5432/vinventure

# JWT Configuration (optional for additional security)
JWT_SECRET=your-jwt-secret-key-here

# Environment
NODE_ENV=development