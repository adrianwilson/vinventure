# VinVenture Lambda - Local Secrets
# Copy this file to .env.local and fill in your values.
# This file is gitignored — never commit real secrets.

# JWT (required)
JWT_SECRET=local-dev-secret-change-me

# Stripe (required)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Cognito (optional for local dev)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# Database (override if not using local Docker)
# DATABASE_URL=postgresql://user:pass@remote-host:5432/vinventure
